DESP_USERNAME=
DESP_PASSWORD=

# Optional: provide an OTP code for accounts with MFA
DESP_OTP_CODE=

# Optional: only needed if you want to run the invalid-credentials negative test
DESP_BAD_PASSWORD=

# Opt-in flags (live tests are skipped unless enabled)
RUN_LIVE_AUTH_TESTS=0
RUN_LIVE_NEGATIVE_TESTS=0

# Optional runtime settings
LIVE_AUTH_TIMEOUT_SECONDS=15

# Optional: provide client credentials for service-account tests
DEDL_CLIENT_ID=
DEDL_CLIENT_SECRET=